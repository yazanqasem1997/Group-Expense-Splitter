// Regenerates the public legal pages from constants/legalText.ts. Run: node scripts/build-legal-pages.mts
import { readFileSync, writeFileSync, mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
const dir = mkdtempSync(join(tmpdir(), "legal-"));
writeFileSync(join(dir, "brand.ts"), readFileSync("constants/brand.ts", "utf8"));
writeFileSync(join(dir, "legalText.ts"), readFileSync("constants/legalText.ts", "utf8").replace('from "./brand"', 'from "./brand.ts"'));
const m = await import(join(dir, "legalText.ts"));
const data = { meta: m.LEGAL_META, privacy: m.privacySections, terms: m.termsSections };
writeFileSync("../api-server/src/lib/legalPages.generated.ts", "// Generated by artifacts/mobile/scripts/build-legal-pages.mts. Do not edit by hand.\nexport const LEGAL = " + JSON.stringify(data, null, 1) + " as const;\n");
console.log("legal pages:", data.privacy.length, "privacy +", data.terms.length, "terms sections");
